# -*- coding: utf-8 -*-
"""
数据获取模块
============
使用 akshare 库获取 A 股历史日频行情数据，
并封装为统一格式的 Pandas DataFrame 返回。
"""

import akshare as ak
import pandas as pd
import requests
import urllib3

# ----------------------------------------------------------------------
# SSL 证书回退处理：
# 在部分代理/沙箱网络环境下，HTTPS 证书链校验可能失败（SSLError）。
# 这里提供一个"仅在证书校验失败时"的降级方案：重试时跳过证书校验。
# 正常网络环境下不会触发该分支，证书校验行为不受影响。
# ----------------------------------------------------------------------
_ssl_fallback_applied = False


def _apply_ssl_fallback() -> None:
    """证书校验失败后，降级为跳过证书校验并屏蔽相应告警。"""
    global _ssl_fallback_applied
    if _ssl_fallback_applied:
        return
    _ssl_fallback_applied = True
    _original = requests.Session.request

    def _patched(self, method, url, **kwargs):  # noqa: ANN001
        kwargs.setdefault("verify", False)
        return _original(self, method, url, **kwargs)

    requests.Session.request = _patched
    urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)


def _safe_fetch(fetch_fn, *args, **kwargs):
    """先按默认方式（严格证书校验）请求；若发生 SSL 错误则降级重试一次。"""
    try:
        return fetch_fn(*args, **kwargs)
    except requests.exceptions.SSLError:
        _apply_ssl_fallback()
        return fetch_fn(*args, **kwargs)


def fetch_data(symbol: str, start_date: str, end_date: str) -> pd.DataFrame:
    """
    获取指定股票在给定日期区间内的历史日频数据。

    参数
    ----
    symbol : str
        股票代码，如 "000001"（平安银行）。
    start_date : str
        开始日期，格式 "YYYYMMDD"，如 "20200101"。
    end_date : str
        结束日期，格式 "YYYYMMDD"，如 "20241231"。

    返回
    ----
    pd.DataFrame
        包含 date, open, high, low, close, volume 六列，
        且按日期升序排列。
    """
    # 调用 akshare 接口获取 A 股日频前复权行情（前复权可保证均线计算的连续性）
    raw = _safe_fetch(
        ak.stock_zh_a_hist,
        symbol=symbol,
        period="daily",
        start_date=start_date,
        end_date=end_date,
        adjust="qfq",
    )

    # 选取并重命名所需的列，统一为小写英文字段名
    df = raw[["日期", "开盘", "最高", "最低", "收盘", "成交量"]].copy()
    df.columns = ["date", "open", "high", "low", "close", "volume"]

    # 类型转换：date 列转为 datetime 类型，价格列转为 float
    df["date"] = pd.to_datetime(df["date"])
    for col in ["open", "high", "low", "close", "volume"]:
        df[col] = pd.to_numeric(df[col], errors="coerce")

    # 去除含有缺失值的行，并按日期升序排列后重置索引
    df = df.dropna().sort_values("date").reset_index(drop=True)
    return df


def fetch_benchmark(symbol: str = "000300", start_date: str = "20200101",
                    end_date: str = "20241231") -> pd.DataFrame:
    """
    获取基准指数（默认沪深300）历史日频数据。

    参数
    ----
    symbol : str
        指数代码，默认 "000300"（沪深300）。
    start_date / end_date : str
        日期区间，格式 "YYYYMMDD"。

    返回
    ----
    pd.DataFrame
        包含 date, close 两列，按日期升序排列。
    """
    # 通过 akshare 获取指数日频行情
    raw = _safe_fetch(
        ak.index_zh_a_hist,
        symbol=symbol,
        period="daily",
        start_date=start_date,
        end_date=end_date,
    )

    df = raw[["日期", "收盘"]].copy()
    df.columns = ["date", "close"]
    df["date"] = pd.to_datetime(df["date"])
    df["close"] = pd.to_numeric(df["close"], errors="coerce")
    df = df.dropna().sort_values("date").reset_index(drop=True)
    return df
