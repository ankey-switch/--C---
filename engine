# -*- coding: utf-8 -*-
"""
回测引擎模块
============
基于事件驱动的向量化日频回测引擎：
  - 支持设置初始资金
  - 计入手续费（佣金，默认万分之三）与滑点（默认千分之一）
  - 信号在 T+1 开盘价执行（与策略模块配合，避免未来函数）
  - 正确计算每日持仓（现金 + 市值）与净值，处理空仓时期
"""

import numpy as np
import pandas as pd


class BacktestEngine:
    """双均线策略回测引擎（单标的、全仓进出、日频）。"""

    def __init__(self,
                 initial_capital: float = 1_000_000.0,
                 commission_rate: float = 0.0003,
                 slippage_rate: float = 0.001):
        """
        参数
        ----
        initial_capital : float
            初始资金（元），默认 100 万。
        commission_rate : float
            手续费率（双边收取），默认万分之三。
        slippage_rate : float
            滑点率（买入价上浮 / 卖出价下调），默认千分之一。
        """
        self.initial_capital = initial_capital
        self.commission_rate = commission_rate
        self.slippage_rate = slippage_rate

    def run(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        执行回测主循环。

        参数
        ----
        df : pd.DataFrame
            经过策略模块处理、包含 signal 列的行情数据
            （date, open, high, low, close, volume, signal）。

        返回
        ----
        pd.DataFrame
            逐日回测明细，包含：
              - cash      : 当日收盘后的现金
              - shares    : 当日收盘后的持股数量
              - position  : 当日收盘后的持仓市值
              - total     : 当日收盘后的总资产（现金 + 持仓市值）
              - nav       : 净值（总资产 / 初始资金）
              - trade     : 当日成交描述（用于绘图标注买卖点）
        """
        cash = self.initial_capital  # 当前现金
        shares = 0                   # 当前持股数量（本策略为整数股）
        records = []                 # 逐日结果记录

        # 逐日遍历行情数据（信号已在策略模块平移一天，指向 T+1 执行）
        for row in df.itertuples(index=False):
            signal = row.signal
            trade_desc = None
            buy_price = sell_price = None

            # ---------- T+1 开盘执行交易 ----------
            if signal == 1 and shares == 0:
                # 买入：以开盘价加上滑点成交
                exec_price = row.open * (1 + self.slippage_rate)
                if exec_price > 0:
                    # 用全部可用资金买入（按整手 100 股向下取整）
                    affordable = cash / ((1 + self.commission_rate) * exec_price)
                    shares = int(affordable // 100) * 100
                    if shares > 0:
                        buy_price = exec_price
                        cost = shares * exec_price
                        commission = cost * self.commission_rate  # 买入手续费
                        cash -= (cost + commission)
                        trade_desc = "BUY"

            elif signal == -1 and shares > 0:
                # 卖出：以开盘价减去滑点成交
                exec_price = row.open * (1 - self.slippage_rate)
                sell_price = exec_price
                proceeds = shares * exec_price
                commission = proceeds * self.commission_rate  # 卖出手续费
                cash += (proceeds - commission)
                shares = 0
                trade_desc = "SELL"

            # ---------- 当日收盘后统计持仓与净值 ----------
            position = shares * row.close                     # 持仓市值（按收盘价估值）
            total = cash + position                           # 总资产
            records.append({
                "date": row.date,
                "open": row.open,
                "close": row.close,
                "signal": signal,
                "cash": cash,
                "shares": shares,
                "position": position,
                "total": total,
                "nav": total / self.initial_capital,
                "trade": trade_desc,
                "buy_price": buy_price,
                "sell_price": sell_price,
            })

        return pd.DataFrame(records)

    # ------------------------------------------------------------------
    # 绩效指标计算
    # ------------------------------------------------------------------
    @staticmethod
    def compute_metrics(result: pd.DataFrame, periods_per_year: int = 252) -> dict:
        """
        根据回测逐日结果计算核心绩效指标。

        参数
        ----
        result : pd.DataFrame
            回测引擎输出的逐日明细（需包含 nav 列）。
        periods_per_year : int
            年化周期数，A 股日频默认 252 个交易日。

        返回
        ----
        dict
            累计收益率、年化收益率、最大回撤、夏普比率等指标。
        """
        nav = result["nav"].values

        # 1) 累计收益率：期末净值 - 1
        cumulative_return = nav[-1] - 1.0

        # 2) 年化收益率：(期末净值)^(年化周期数/总交易日) - 1
        n_days = len(nav)
        annual_return = nav[-1] ** (periods_per_year / n_days) - 1.0 if n_days > 0 else 0.0

        # 3) 最大回撤：历史最高净值到当前净值的最大跌幅
        running_max = np.maximum.accumulate(nav)
        drawdown = nav / running_max - 1.0
        max_drawdown = drawdown.min()

        # 4) 夏普比率：日收益均值 / 日收益标准差 * sqrt(252)，无风险利率取 0
        daily_ret = pd.Series(nav).pct_change().dropna()
        sharpe = (daily_ret.mean() / daily_ret.std() * np.sqrt(periods_per_year)
                  if daily_ret.std() > 0 else 0.0)

        # 交易次数统计（一对买卖算一次完整交易）
        n_trades = int((result["trade"] == "BUY").sum())

        return {
            "累计收益率": f"{cumulative_return:.2%}",
            "年化收益率": f"{annual_return:.2%}",
            "最大回撤": f"{max_drawdown:.2%}",
            "夏普比率": f"{sharpe:.2f}",
            "交易次数（买入）": n_trades,
            "期末总资产(元)": f"{result['total'].iloc[-1]:,.2f}",
        }
