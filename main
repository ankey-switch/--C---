# -*- coding: utf-8 -*-
"""
量化回测项目主入口
==================
整体流程：
  1. 通过 data 模块获取个股（平安银行）与基准（沪深300）日频数据
  2. 通过 strategy 模块计算双均线买卖信号（T+1 执行，避免未来函数）
  3. 通过 backtest 模块执行回测（初始资金 / 手续费 / 滑点）
  4. 通过 output 模块输出：
     - 全区间绩效指标 + 策略 vs 基准超额收益对比
     - 样本内 / 样本外分段绩效（验证策略稳健性，避免过拟合质疑）
     - 归一化净值曲线图（标注买卖点）与交易明细 CSV
"""

import os
import sys

import pandas as pd

# 将项目根目录加入 sys.path，保证各模块可被正确导入
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from data.data_fetcher import fetch_data, fetch_benchmark
from strategy.dual_ma import dual_ma_signals
from backtest.engine import BacktestEngine
from output.results import (print_metrics, print_comparison,
                            plot_nav_curve, export_trades)


def segment_report(name: str, seg_df: pd.DataFrame, seg_bench: pd.DataFrame,
                   engine: BacktestEngine) -> None:
    """
    对给定数据段执行回测，打印该段指标及与基准的超额收益对比。

    参数
    ----
    name : str
        数据段名称（"样本内" / "样本外"）。
    seg_df : pd.DataFrame
        该段的带信号行情数据（已由全量数据统一计算信号后切分）。
    seg_bench : pd.DataFrame
        该段的基准指数数据（date, close）。
    engine : BacktestEngine
        回测引擎实例。
    """
    if len(seg_df) < 30:
        print(f"[{name}] 数据不足（{len(seg_df)} 个交易日），跳过分段报告")
        return

    # 策略在该段的独立回测（初始资金重新设定，两段独立核算）
    seg_result = engine.run(seg_df)
    strat_m = BacktestEngine.compute_metrics(seg_result)

    # 基准在同段的表现：把收盘价序列归一化成净值后复用同一指标计算
    seg_bench = seg_bench[(seg_bench["date"] >= seg_df["date"].iloc[0]) &
                          (seg_bench["date"] <= seg_df["date"].iloc[-1])].reset_index(drop=True)
    bench_nav = pd.DataFrame({"nav": seg_bench["close"] / seg_bench["close"].iloc[0]})
    bench_m = BacktestEngine.compute_metrics(bench_nav)

    print(f"\n{'#' * 50}\n  {name}区间："
          f"{seg_df['date'].iloc[0].date()} ~ {seg_df['date'].iloc[-1].date()}"
          f"（{len(seg_df)} 个交易日）\n{'#' * 50}")
    print_metrics(strat_m, title=f"{name}·策略指标")
    print_comparison(strat_m, bench_m)


def main():
    # ==================== 回测参数设置 ====================
    symbol = "000001"          # 标的股票：平安银行
    start_date = "20200101"    # 回测开始日期
    end_date = "20241231"      # 回测结束日期
    fast_window = 5            # 快线窗口（5 日均线）
    slow_window = 20           # 慢线窗口（20 日均线）
    initial_capital = 1_000_000.0   # 初始资金：100 万元
    commission_rate = 0.0003        # 手续费：万分之三
    slippage_rate = 0.001           # 滑点：千分之一
    split_date = "20240101"         # 样本内/样本外划分点（前 4 年调参验证，后 1 年留作样本外）

    # ==================== 1. 数据获取 ====================
    print(f"[数据] 正在获取 {symbol} 日频数据（{start_date} ~ {end_date}）...")
    df = fetch_data(symbol, start_date, end_date)
    print(f"[数据] 获取成功，共 {len(df)} 个交易日，区间："
          f"{df['date'].iloc[0].date()} ~ {df['date'].iloc[-1].date()}")

    print("[数据] 正在获取基准指数（沪深300）数据...")
    benchmark = fetch_benchmark("000300", start_date, end_date)
    print(f"[数据] 基准数据获取成功，共 {len(benchmark)} 个交易日")

    # ==================== 2. 策略信号计算 ====================
    print(f"[策略] 计算双均线信号（MA{fast_window} 上穿/下穿 MA{slow_window}）...")
    df = dual_ma_signals(df, fast_window=fast_window, slow_window=slow_window)
    n_buy = (df["signal_raw"] == 1).sum()
    n_sell = (df["signal_raw"] == -1).sum()
    print(f"[策略] 信号统计：金叉（买入信号）{n_buy} 次，死叉（卖出信号）{n_sell} 次")

    # ==================== 3. 全区间回测 ====================
    print(f"[回测] 初始资金 {initial_capital:,.0f} 元，"
          f"手续费 {commission_rate:.4%}，滑点 {slippage_rate:.2%}，T+1 开盘执行")
    engine = BacktestEngine(initial_capital=initial_capital,
                            commission_rate=commission_rate,
                            slippage_rate=slippage_rate)
    result = engine.run(df)

    # ==================== 4. 结果输出 ====================
    # 4.1 全区间指标 + 与基准的超额收益对比
    metrics = BacktestEngine.compute_metrics(result)
    print_metrics(metrics, title="全区间回测绩效指标")

    bench_nav = pd.DataFrame({"nav": benchmark["close"] / benchmark["close"].iloc[0]})
    bench_metrics = BacktestEngine.compute_metrics(bench_nav)
    print_comparison(metrics, bench_metrics)

    # 4.2 样本内 / 样本外分段报告
    # 信号基于全量数据一次性计算后按日期切分：
    # 样本外段开头的均线已有样本内尾部的完整预热历史，与实盘可用信息一致，无未来函数。
    split_ts = pd.Timestamp(split_date)
    train_df = df[df["date"] < split_ts].reset_index(drop=True)
    test_df = df[df["date"] >= split_ts].reset_index(drop=True)
    segment_report("样本内", train_df, benchmark, engine)
    segment_report("样本外", test_df, benchmark, engine)

    # 4.3 归一化净值曲线图（标注买卖点）
    save_path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                             "output", "nav_curve.png")
    plot_nav_curve(result, benchmark, save_path=save_path)

    # 4.4 交易明细 CSV
    trade_path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                              "output", "trades.csv")
    export_trades(result, save_path=trade_path)


if __name__ == "__main__":
    main()
