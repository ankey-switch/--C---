# -*- coding: utf-8 -*-
"""
量化回测项目主入口
==================
整体流程：
  1. 通过 data 模块获取个股（平安银行）与基准（沪深300）日频数据
  2. 通过 strategy 模块计算双均线买卖信号（T+1 执行，避免未来函数）
  3. 通过 backtest 模块执行回测（初始资金 / 手续费 / 滑点）
  4. 通过 output 模块打印绩效指标并绘制归一化净值曲线图
"""

import os
import sys

# 将项目根目录加入 sys.path，保证各模块可被正确导入
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from data.data_fetcher import fetch_data, fetch_benchmark
from strategy.dual_ma import dual_ma_signals
from backtest.engine import BacktestEngine
from output.results import print_metrics, plot_nav_curve, export_trades


def main():
    # ==================== 回测参数设置 ====================
    symbol = "000001"          # 标的股票：平安银行
    start_date = "20200101"    # 回测开始日期
    end_date = "20241231"      # 回测结束日期
    fast_window = 5            # 快线窗口（5 日均线）
    slow_window = 20           # 慢线窗口（20 日均线）
    initial_capital = 1_000_000.0   # 初始资金：100 万元
    commission_rate = 0.0003        # 手续费：万分之三
    slippage_rate = 0.001           # 滑点：千分之一

    # ==================== 1. 数据获取 ====================
    print(f"[数据] 正在获取 {symbol} 日频数据（{start_date} ~ {end_date}）...")
    df = fetch_data(symbol, start_date, end_date)
    print(f"[数据] 获取成功，共 {len(df)} 个交易日，区间："
          f"{df['date'].iloc[0].date()} ~ {df['date'].iloc[-1].date()}")

    print("[数据] 正在获取基准指数（沪深300）数据...")
    benchmark = fetch_benchmark("000300", start_date, end_date)
    print(f"[数据] 基准数据获取成功，共 {len(benchmark)} 个交易日")

    # ==================== 2. 策略信号计算 ====================
    print(f"[策略] 计算双均线信号（MA{fast_window} 上穿/下穿 MA{slow_window}）...")
    df = dual_ma_signals(df, fast_window=fast_window, slow_window=slow_window)
    n_buy = (df["signal_raw"] == 1).sum()
    n_sell = (df["signal_raw"] == -1).sum()
    print(f"[策略] 信号统计：金叉（买入信号）{n_buy} 次，死叉（卖出信号）{n_sell} 次")

    # ==================== 3. 执行回测 ====================
    print(f"[回测] 初始资金 {initial_capital:,.0f} 元，"
          f"手续费 {commission_rate:.4%}，滑点 {slippage_rate:.2%}，T+1 开盘执行")
    engine = BacktestEngine(initial_capital=initial_capital,
                            commission_rate=commission_rate,
                            slippage_rate=slippage_rate)
    result = engine.run(df)

    # ==================== 4. 结果输出 ====================
    metrics = BacktestEngine.compute_metrics(result)
    print_metrics(metrics)

    save_path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                             "output", "nav_curve.png")
    plot_nav_curve(result, benchmark, save_path=save_path)

    trade_path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                              "output", "trades.csv")
    export_trades(result, save_path=trade_path)


if __name__ == "__main__":
    main()
