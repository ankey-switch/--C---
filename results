def print_metrics(metrics: dict, title: str = "") -> None:
    """
    格式化打印单组绩效指标。

    参数
    ----
    metrics : dict
        BacktestEngine.compute_metrics() 的返回值，键包括：
        cumulative_return, annual_return, max_drawdown,
        sharpe, n_trades, final_total
    title : str
        打印标题（可选），为空则不打印标题行
    """
    width = 44
    print("\n" + "=" * width)
    if title:
        # 居中对齐标题
        print(f"  {title}".center(width))
        print("-" * width)

    def _fmt_pct(val):
        """将浮点数格式化为百分比字符串，None 显示为 N/A。"""
        if val is None:
            return "N/A"
        return f"{val:>+.2%}"

    def _fmt_float(val, decimals=4):
        if val is None:
            return "N/A"
        return f"{val:>{decimals + 6}.{decimals}f}"

    def _fmt_money(val):
        if val is None:
            return "N/A"
        return f"{val:>,.2f} 元"

    # 从 dict 中容错取值（有 .get 的话用 .get，否则直接取）
    get = metrics.get if isinstance(metrics, dict) else lambda k, d=None: getattr(metrics, k, d)

    print(f"  {'累计收益率':<12}{_fmt_pct(get('cumulative_return'))}")
    print(f"  {'年化收益率':<12}{_fmt_pct(get('annual_return'))}")
    print(f"  {'最大回撤':<12}{_fmt_pct(get('max_drawdown'))}")
    print(f"  {'夏普比率':<12}{_fmt_float(get('sharpe'))}")
    print(f"  {'买入次数':<12}{get('n_trades', 'N/A')}")

    final_total = get("final_total")
    if final_total is not None:
        print(f"  {'期末总资产':<12}{_fmt_money(final_total)}")

    print("=" * width)


def print_comparison(strat_metrics: dict, bench_metrics: dict) -> None:
    """
    并排打印策略 vs 基准的超额收益对比表。

    参数
    ----
    strat_metrics : dict
        策略的绩效指标字典。
    bench_metrics : dict
        基准（沪深300）的绩效指标字典。
    """
    width = 54
    print("\n" + "=" * width)
    print("  策略 vs 基准  超额收益对比".center(width))
    print("-" * width)
    print(f"  {'指标':<14}{'策略':>10}{'基准':>10}{'超额':>10}")
    print("-" * width)

    sg = strat_metrics.get if isinstance(strat_metrics, dict) \
        else lambda k, d=None: getattr(strat_metrics, k, d)
    bg = bench_metrics.get if isinstance(bench_metrics, dict) \
        else lambda k, d=None: getattr(bench_metrics, k, d)

    def _diff_pct(key):
        """计算百分比类指标的超额值（策略 - 基准）。"""
        s, b = sg(key), bg(key)
        if s is None or b is None:
            return None
        return s - b

    def _row(label, key):
        s, b = sg(key), bg(key)
        diff = _diff_pct(key)
        s_str = f"{s:>+.2%}" if s is not None else "N/A"
        b_str = f"{b:>+.2%}" if b is not None else "N/A"
        d_str = f"{diff:>+.2%}" if diff is not None else "N/A"
        print(f"  {label:<14}{s_str:>10}{b_str:>10}{d_str:>10}")

    _row("累计收益率", "cumulative_return")
    _row("年化收益率", "annual_return")
    _row("最大回撤",   "max_drawdown")

    # 夏普比率不是百分比，单独处理
    s_sharpe = sg("sharpe")
    b_sharpe = bg("sharpe")
    diff_sharpe = (s_sharpe - b_sharpe) if (s_sharpe is not None and b_sharpe is not None) else None
    print(f"  {'夏普比率':<14}"
          f"{(s_sharpe or 0):>+10.4f}"
          f"{(b_sharpe or 0):>+10.4f}"
          f"{(diff_sharpe or 0):>+10.4f}")

    print("=" * width)


def plot_nav_curve(result, benchmark: pd.DataFrame,
                   save_path: str = "output/nav_curve.png") -> None:
    """
    绘制策略与基准（沪深300）的归一化净值曲线，并标注买卖点。

    参数
    ----
    result : pd.DataFrame 或兼容对象
        BacktestEngine.run() 的回测结果。
    benchmark : pd.DataFrame
        基准数据，至少含 date、close 两列。
    save_path : str
        图片保存路径（会自动创建父目录）。
    """
    # ── 自动创建目录 ───────────────────────────────────────────────
    os.makedirs(os.path.dirname(os.path.abspath(save_path)), exist_ok=True)

    # ── 提取策略净值序列 ────────────────────────────────────────────
    strategy_nav = _extract_nav(result)

    # ── 构造基准净值序列（收盘价归一化到 1.0）──────────────────────
    bench = benchmark.copy()
    bench["date"] = pd.to_datetime(bench["date"])
    bench = bench.set_index("date").sort_index()
    benchmark_nav = bench["close"] / bench["close"].iloc[0]
    benchmark_nav.name = "benchmark_nav"

    # ── 提取交易记录 ────────────────────────────────────────────────
    trades = _extract_trades(result)

    # ── 绘图 ────────────────────────────────────────────────────────
    fig, ax = plt.subplots(figsize=(14, 6))

    ax.plot(strategy_nav.index,  strategy_nav.values,
            label="策略净值",   color="#E63946", linewidth=1.8, zorder=3)
    ax.plot(benchmark_nav.index, benchmark_nav.values,
            label="沪深300基准", color="#457B9D", linewidth=1.5,
            linestyle="--", zorder=2)

    # 净值基准线 1.0（灰色虚线）
    ax.axhline(y=1.0, color="#999999", linestyle=":", linewidth=0.9, zorder=1)

    # ── 标注买卖点 ──────────────────────────────────────────────────
    if not trades.empty:
        trades = trades.copy()
        trades["date"] = pd.to_datetime(trades["date"])

        # 将 trades 的 date 匹配到 strategy_nav 的索引
        # 若当日不在序列索引里（如节假日调整），取最近的有效交易日
        nav_index = strategy_nav.index

        buy_trades  = trades[trades["action"] == "buy"]
        sell_trades = trades[trades["action"] == "sell"]

        def _nearest_nav(date):
            """返回距 date 最近的净值，用于标注点的 y 坐标。"""
            if date in nav_index:
                return strategy_nav.loc[date]
            # 找最近的索引位置
            pos = nav_index.searchsorted(date)
            pos = min(pos, len(nav_index) - 1)
            return strategy_nav.iloc[pos]

        for _, row in buy_trades.iterrows():
            y = _nearest_nav(row["date"])
            ax.scatter(row["date"], y,
                       marker="^", color="#2DC653", s=130,
                       zorder=5, label="_nolegend_")
            ax.annotate("买", xy=(row["date"], y),
                        xytext=(0, 12), textcoords="offset points",
                        ha="center", va="bottom",
                        fontsize=8, color="#2DC653",
                        arrowprops=dict(arrowstyle="-", color="#2DC653",
                                        lw=0.6))

        for _, row in sell_trades.iterrows():
            y = _nearest_nav(row["date"])
            ax.scatter(row["date"], y,
                       marker="v", color="#E63946", s=130,
                       zorder=5, label="_nolegend_")
            ax.annotate("卖", xy=(row["date"], y),
                        xytext=(0, -14), textcoords="offset points",
                        ha="center", va="top",
                        fontsize=8, color="#E63946",
                        arrowprops=dict(arrowstyle="-", color="#E63946",
                                        lw=0.6))

    # ── 坐标轴装饰 ──────────────────────────────────────────────────
    # 计算回测区间用于标题
    try:
        start_str = str(strategy_nav.index[0].date())
        end_str   = str(strategy_nav.index[-1].date())
        ax.set_title(f"策略 vs 沪深300  归一化净值曲线\n{start_str} ~ {end_str}",
                     fontsize=13, pad=12)
    except Exception:
        ax.set_title("策略 vs 沪深300  归一化净值曲线", fontsize=13, pad=12)

    ax.set_xlabel("日期", fontsize=11)
    ax.set_ylabel("净值（起点 = 1.0）", fontsize=11)

    # Y 轴格式化为两位小数
    ax.yaxis.set_major_formatter(mticker.FormatStrFormatter("%.2f"))

    # X 轴：每季度一个主刻度，格式 YYYY-MM
    ax.xaxis.set_major_locator(mdates.MonthLocator(interval=3))
    ax.xaxis.set_major_formatter(mdates.DateFormatter("%Y-%m"))
    fig.autofmt_xdate(rotation=30)

    ax.grid(True, linestyle="--", alpha=0.35)

    # 图例去重：排除带 "_nolegend_" 标签的买卖散点
    handles, labels = ax.get_legend_handles_labels()
    deduped = [(h, l) for h, l in zip(handles, labels) if not l.startswith("_")]
    ax.legend([h for h, _ in deduped], [l for _, l in deduped],
              loc="upper left", fontsize=10)

    plt.tight_layout()
    plt.savefig(save_path, dpi=150, bbox_inches="tight")
    plt.close(fig)

    print(f"\n✅ 净值曲线图已保存至：{save_path}")


def export_trades(result, save_path: str = "output/trades.csv") -> None:
    """
    将交易明细导出为 CSV 文件。

    参数
    ----
    result : pd.DataFrame 或兼容对象
        BacktestEngine.run() 的回测结果。
    save_path : str
        CSV 保存路径（会自动创建父目录）。
    """
    os.makedirs(os.path.dirname(os.path.abspath(save_path)), exist_ok=True)

    trades = _extract_trades(result)

    if trades.empty:
        print("\n⚠️  未检测到任何交易记录，CSV 未生成。")
        return

    # 格式化价格列保留4位小数，日期列统一格式
    trades = trades.copy()
    if "date" in trades.columns:
        trades["date"] = pd.to_datetime(trades["date"]).dt.strftime("%Y-%m-%d")
    if "price" in trades.columns:
        trades["price"] = trades["price"].round(4)

    trades.to_csv(save_path, index=False, encoding="utf-8-sig")
    # utf-8-sig 带 BOM，Excel 直接双击打开不乱码
    print(f"✅ 交易明细已导出至：{save_path}（共 {len(trades)} 笔）")
