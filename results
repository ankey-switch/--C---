# -*- coding: utf-8 -*-
"""
output/results.py
=================
结果输出模块，负责：
  1. print_metrics     — 格式化打印单组绩效指标
  2. print_comparison  — 打印策略 vs 基准的超额收益对比
  3. plot_nav_curve    — 绘制归一化净值曲线并标注买卖点
  4. export_trades     — 导出交易明细到 CSV

设计原则：
  本模块不依赖 BacktestEngine 的具体实现，
  所有对 result（DataFrame 或 dict）的字段访问都通过
  容错辅助函数 _extract_nav / _extract_trades 完成，
  即使将来组员修改引擎内部结构也不会导致本模块崩溃。
"""

import os
import warnings

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
import matplotlib.ticker as mticker


# ══════════════════════════════════════════════════════════════════════
#  中文字体 & 样式全局配置
#  优先尝试 Windows 黑体，回退到 macOS / Linux 通用方案
# ══════════════════════════════════════════════════════════════════════
def _setup_matplotlib() -> None:
    """配置 matplotlib 中文字体，防止方块乱码。"""
    candidate_fonts = ["SimHei", "Microsoft YaHei", "PingFang SC",
                       "Heiti TC", "WenQuanYi Micro Hei"]
    available = set()
    try:
        from matplotlib import font_manager
        available = {f.name for f in font_manager.fontManager.ttflist}
    except Exception:
        pass

    chosen = next((f for f in candidate_fonts if f in available), None)
    if chosen:
        plt.rcParams["font.sans-serif"] = [chosen]
    else:
        # 找不到中文字体时发出警告，但不中断程序
        warnings.warn(
            "未找到中文字体，图表中的中文可能显示为方块。"
            "建议安装 SimHei 或 Microsoft YaHei。",
            UserWarning,
            stacklevel=2,
        )
    plt.rcParams["axes.unicode_minus"] = False   # 修复负号显示异常


_setup_matplotlib()


# ══════════════════════════════════════════════════════════════════════
#  容错辅助函数
# ══════════════════════════════════════════════════════════════════════

def _get_field(obj, *keys):
    """
    从 DataFrame、dict 或普通对象中依次尝试 keys，返回第一个成功的值。
    若全部失败则返回 None。

    示例：
        _get_field(result, "nav")          # DataFrame 列 或 dict 键
        _get_field(result, "date")
    """
    for key in keys:
        # ── 优先尝试 DataFrame 列 ──────────────────────────────────
        if isinstance(obj, pd.DataFrame):
            if key in obj.columns:
                return obj[key]
        # ── 再尝试 dict 键 ────────────────────────────────────────
        elif isinstance(obj, dict):
            if key in obj:
                return obj[key]
        # ── 最后尝试对象属性 ──────────────────────────────────────
        elif hasattr(obj, key):
            return getattr(obj, key)
    return None


def _extract_nav(result) -> pd.Series:
    """
    从回测结果中提取净值序列，返回以日期为索引的 pd.Series。

    兼容以下格式：
      - pd.DataFrame（engine.run() 的标准输出，含 date、nav 列）
      - dict（含 "nav" 键，值为列表或 Series）
      - 带 .nav_series 属性的自定义对象

    若无法提取到合法数据，抛出 ValueError 并给出明确提示。
    """
    # ── 尝试提取 nav 值 ────────────────────────────────────────────
    nav_values = _get_field(result, "nav", "nav_series", "navs")
    if nav_values is None:
        raise ValueError(
            "_extract_nav：在 result 中找不到净值字段（尝试了 nav / nav_series / navs）。"
            "请检查回测引擎的返回结构。"
        )

    # ── 尝试提取日期索引 ───────────────────────────────────────────
    date_values = _get_field(result, "date", "dates", "index")

    if date_values is not None:
        try:
            index = pd.to_datetime(date_values)
            nav_series = pd.Series(nav_values.values
                                   if isinstance(nav_values, pd.Series)
                                   else nav_values,
                                   index=index,
                                   name="nav")
            return nav_series
        except Exception:
            pass  # 日期解析失败则退化为整数索引

    # ── 退化：直接用整数索引 ───────────────────────────────────────
    if isinstance(nav_values, pd.Series):
        return nav_values.rename("nav")
    return pd.Series(nav_values, name="nav")


def _extract_trades(result) -> pd.DataFrame:
    """
    从回测结果中提取交易记录，返回标准格式的 pd.DataFrame。

    标准输出列：date, action（'buy'/'sell'）, price

    兼容以下情况：
      - engine.run() 的标准输出：trade 列值为 'BUY'/'SELL'（大写字符串）
        buy_price / sell_price 列分别记录成交价
      - trades 列为 DataFrame 的情况（某些自定义引擎）
      - 完全没有交易记录时返回空 DataFrame
    """
    empty = pd.DataFrame(columns=["date", "action", "price"])

    # ── 情形一：标准 DataFrame，含 trade 列（engine.run() 的输出）───
    if isinstance(result, pd.DataFrame) and "trade" in result.columns:
        # 只保留实际成交行（trade 列非 None / NaN）
        trades = result[result["trade"].notna()].copy()
        if trades.empty:
            return empty

        rows = []
        for _, row in trades.iterrows():
            action = str(row["trade"]).strip().upper()
            if action == "BUY":
                # 买入价优先从 buy_price 列取，回退到 open 列
                price = row.get("buy_price") if "buy_price" in trades.columns else None
                if price is None or pd.isna(price):
                    price = row.get("open", np.nan)
                rows.append({"date": row["date"], "action": "buy", "price": price})
            elif action == "SELL":
                price = row.get("sell_price") if "sell_price" in trades.columns else None
                if price is None or pd.isna(price):
                    price = row.get("open", np.nan)
                rows.append({"date": row["date"], "action": "sell", "price": price})
        return pd.DataFrame(rows, columns=["date", "action", "price"])

    # ── 情形二：result 中有独立的 trades 字段 ─────────────────────
    trades_field = _get_field(result, "trades", "trade_records", "orders")
    if trades_field is not None and len(trades_field) > 0:
        df = pd.DataFrame(trades_field)
        # 统一列名：type → action
        if "type" in df.columns and "action" not in df.columns:
            df = df.rename(columns={"type": "action"})
        # 统一 action 为小写
        if "action" in df.columns:
            df["action"] = df["action"].str.lower()
        return df

    return empty


